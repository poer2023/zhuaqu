# Database - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/zhaqu?schema=public"

# Gemini API (optional) - only used by /video-to-thread
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI API (optional) - used by rewrite; if unset, rewrite uses mock output
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Local media storage (relative to project root or absolute path)
MEDIA_DIR="data/media"

# yt-dlp (Optional) - for cases where X requires an authenticated session
# Export your own cookies to a Netscape cookies.txt file and point yt-dlp to it.
YTDLP_COOKIES=""
YTDLP_PROXY=""
YTDLP_USER_AGENT=""

# Worker
WORKER_POLL_INTERVAL_MS="2000"
WORKER_ROLE="all" # all | capture | pipeline | publish

# Playwright / X session (Sync/Publish)
PUBLISH_HEADLESS="true"
X_USER_AGENT=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# X (Twitter) OAuth (legacy / optional)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
