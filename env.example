# Database - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/zhaqu?schema=public"

# Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# (Optional) OpenAI API (legacy text rewrite endpoint)
OPENAI_API_KEY="your-openai-api-key"

# Local media storage (relative to project root or absolute path)
MEDIA_DIR="data/media"

# yt-dlp (Optional) - for cases where X requires an authenticated session
# Export your own cookies to a Netscape cookies.txt file and point yt-dlp to it.
YTDLP_COOKIES=""
YTDLP_PROXY=""
YTDLP_USER_AGENT=""

# Worker
WORKER_POLL_INTERVAL_MS="2000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# X (Twitter) OAuth
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"
