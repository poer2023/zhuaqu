// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== 核心枚举 ====================

enum CaptureStatus {
  QUEUED
  FETCHING
  READY
  FAILED
}

enum RewriteStatus {
  NONE
  DRAFTING
  GENERATED
  APPROVED
  REWORK
  REJECTED
}

enum PublishStatus {
  NOT_PUBLISHED
  QUEUED
  PUBLISHED
  FAILED
  UNKNOWN  // 发布结果未知，需人工确认
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  PARTIAL_FAILED
}

// ==================== 统一编排任务 (v2) ====================

enum OrchestratorJobType {
  INGEST_URL
  SYNC_LIKES
  SYNC_BOOKMARKS
  SYNC_TIMELINE
  REWRITE
  PUBLISH
  PIPELINE
}

enum OrchestratorJobStatus {
  PENDING
  RUNNING
  PAUSED
  FAILED
  DONE
  CANCELED
}

enum OrchestratorStepType {
  CAPTURE
  EXTRACT
  MEDIA
  REWRITE
  QA
  SCHEDULE
  PUBLISH
}

enum OrchestratorStepStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AuditAction {
  INGEST_CREATED
  INGEST_COMPLETED
  INGEST_FAILED
  REWRITE_CREATED
  REWRITE_GENERATED
  REWRITE_APPROVED
  REWRITE_REJECTED
  REWRITE_REWORK
  PUBLISH_QUEUED
  PUBLISH_SUCCEEDED
  PUBLISH_FAILED
  ITEM_MOVED
  ITEM_DELETED
  ITEM_TAGGED
  ITEM_UNTAGGED
  ITEM_ARCHIVED
  ITEM_UNARCHIVED
}

// ==================== 工作区与素材池 ====================

model Workspace {
  id              String   @id @default(cuid())
  name            String
  description     String?
  defaultPoolId   String?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  pools           Pool[]
  jobs            Job[]
  contentItems    ContentItem[]
  tags            Tag[]
  rewritePresets  RewritePreset[]
  publishJobs     PublishJob[]
  ingestJobs      IngestJob[]
  rewriteBatches  RewriteBatch[]
  auditLogs       AuditLog[]
  xAccounts       XAccount[]   // 支持多账号
  syncJobs        SyncJob[]
  brandVoices     BrandVoice[]
  topics          Topic[]      // 内容发现话题
  evergreenQueues EvergreenQueue[]  // 常青内容队列

  @@map("workspaces")
}

model Pool {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs         Job[]
  contentItems ContentItem[]
  ingestJobs   IngestJob[]
  syncJobs     SyncJob[]

  @@index([workspaceId])
  @@map("pools")
}

// ==================== 统一 Job/Step 编排 ====================

model Job {
  id              String                @id @default(cuid())
  type            OrchestratorJobType
  status          OrchestratorJobStatus @default(PENDING)
  workspaceId     String
  poolId          String?
  config          Json                  @default("{}")
  traceId         String?               @unique
  idempotencyKey  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pool            Pool?                 @relation(fields: [poolId], references: [id], onDelete: SetNull)
  steps           Step[]
  contentItems    ContentItem[]
  ingestJob       IngestJob?
  syncJob         SyncJob?
  publishJob      PublishJob?
  rewriteBatch    RewriteBatch?
  rewriteVersions RewriteVersion[]

  @@index([workspaceId])
  @@index([poolId])
  @@index([type])
  @@index([status])
  @@unique([type, idempotencyKey])
  @@map("jobs")
}

model Step {
  id           String                  @id @default(cuid())
  jobId        String
  type         OrchestratorStepType
  position     Int                     @default(0)
  status       OrchestratorStepStatus  @default(QUEUED)
  attemptCount Int                     @default(0)
  maxAttempts  Int                     @default(3)
  availableAt  DateTime                @default(now())
  
  // Lease/Heartbeat 机制
  leaseOwner     String?               // worker 实例标识
  leaseExpiresAt DateTime?             // 租约过期时间
  heartbeatAt    DateTime?             // 最后心跳时间
  
  // Step 依赖
  dependsOnStepId String?              // 依赖的前置 step
  
  inputRef     Json                    @default("{}")
  outputRef    Json                    @default("{}")
  error        Json                    @default("{}")
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  job             Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dependsOnStep   Step?                @relation("StepDependency", fields: [dependsOnStepId], references: [id])
  dependentSteps  Step[]               @relation("StepDependency")
  rewriteVersions RewriteVersion[]
  events          StepEvent[]

  @@index([jobId])
  @@index([jobId, position])
  @@index([status, availableAt])
  @@index([type, status, availableAt])
  @@index([status, leaseExpiresAt])    // watchdog 查询索引
  @@index([dependsOnStepId])
  @@map("steps")
}

// Step 增量事件日志
model StepEvent {
  id        String   @id @default(cuid())
  stepId    String
  type      String   // "log" | "progress" | "output" | "error"
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  step      Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, createdAt])
  @@index([stepId, type])
  @@map("step_events")
}

// ==================== 内容条目 ====================

model ContentItem {
  id              String        @id @default(cuid())
  workspaceId     String
  poolId          String
  jobId           String?
  
  // 来源信息
  sourceId        String        // tweet_id
  sourceUrl       String
  authorHandle    String
  authorName      String?
  authorAvatar    String?
  
  // 原始内容
  textOriginal    String        @db.Text
  lang            String?
  rawJson         Json
  
  // 媒体（图片、视频链接数组）
  media           Json          @default("[]")
  
  // 线程信息
  threadId        String?       // 如果是线程的一部分
  threadPosition  Int?          // 在线程中的位置
  
  // 状态
  captureStatus   CaptureStatus @default(QUEUED)
  rewriteStatus   RewriteStatus @default(NONE)
  publishStatus   PublishStatus @default(NOT_PUBLISHED)
  
  // 管理
  notes           String?       @db.Text
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 关联
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pool            Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  job             Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tags            ContentItemTag[]
  rewriteVersions RewriteVersion[]
  publishResults  PublishResult[]
  auditLogs       AuditLog[]

  @@unique([workspaceId, sourceId])
  @@index([workspaceId])
  @@index([poolId])
  @@index([jobId])
  @@index([captureStatus])
  @@index([rewriteStatus])
  @@index([publishStatus])
  @@index([authorHandle])
  // Composite indexes for common query patterns
  @@index([workspaceId, poolId, rewriteStatus])
  @@index([workspaceId, publishStatus])
  @@index([poolId, captureStatus])
  @@index([workspaceId, poolId, publishStatus])
  @@index([workspaceId, createdAt])
  @@map("content_items")
}

// ==================== 标签系统 ====================

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?  // hex color
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItems ContentItemTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

model ContentItemTag {
  id            String   @id @default(cuid())
  contentItemId String
  tagId         String
  createdAt     DateTime @default(now())

  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, tagId])
  @@map("content_item_tags")
}

// ==================== 入库任务 ====================

// @deprecated v1 表 - 仅作为业务视图使用，编排以 Job/Step 为准
// 新代码应使用 Job/Step 模型，此表仅保留用于现有业务逻辑和向后兼容
model IngestJob {
  id          String    @id @default(cuid())
  workspaceId String
  poolId      String
  jobId       String?   @unique
  
  // 输入
  urls        Json      // string[]
  options     Json      @default("{}")  // thread_mode, quote_mode, media_mode
  tags        Json      @default("[]")  // tag ids to apply
  notes       String?
  
  // 状态
  status      JobStatus @default(QUEUED)
  
  // 进度
  total       Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  deduped     Int       @default(0)
  
  // 结果
  failures    Json      @default("[]")  // [{url, error, code}]
  
  // 时间
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pool        Pool      @relation(fields: [poolId], references: [id], onDelete: Cascade)
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([jobId])
  @@index([status])
  @@map("ingest_jobs")
}

// ==================== 品牌声音系统 ====================

model BrandVoice {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?

  // 训练样本
  sampleTweets  Json     @default("[]")  // 用户提供的示例推文

  // AI 分析结果
  styleProfile  Json?    // { tone, vocabulary, patterns, sentenceStructure }
  systemPrompt  String?  @db.Text  // 生成的专属提示词

  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([isDefault])
  @@map("brand_voices")
}

// ==================== 改写系统 ====================

model RewritePreset {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  
  // 改写参数
  targetPersona   String?  // 目标账号定位
  audienceTone    String?  // 受众与语气
  stance          String?  // 观点立场：agree/disagree/neutral/compare/supplement
  outputFormat    String   @default("single") // single/thread
  includeHook     Boolean  @default(true)
  includeConclusion Boolean @default(true)
  includeCTA      Boolean  @default(false)
  requireFactCheck Boolean @default(true)
  includeSource   Boolean  @default(false)
  language        String   @default("zh")
  
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rewriteBatches RewriteBatch[]

  @@index([workspaceId])
  @@map("rewrite_presets")
}

// @deprecated v1 表 - 仅作为业务视图使用，编排以 Job/Step 为准
// 新代码应使用 Job/Step 模型，此表仅保留用于 RewriteVersion 关联和向后兼容
model RewriteBatch {
  id          String    @id @default(cuid())
  workspaceId String
  presetId    String?
  jobId       String?   @unique
  name        String
  
  // 参数快照
  params      Json      @default("{}")
  
  // 状态
  status      JobStatus @default(QUEUED)
  
  // 进度
  total       Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  preset      RewritePreset? @relation(fields: [presetId], references: [id])
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  versions    RewriteVersion[]

  @@index([workspaceId])
  @@index([jobId])
  @@index([status])
  @@map("rewrite_batches")
}

model RewriteVersion {
  id            String        @id @default(cuid())
  contentItemId String
  batchId       String?
  jobId         String?
  stepId        String?
  
  // 版本号
  version       Int           @default(1)
  
  // 改写内容
  output        Json          // 单条: {text} / 线程: [{text, position}]
  outputFormat  String        @default("single")
  
  // 参数快照
  paramsSnapshot Json         @default("{}")
  
  // 状态
  status        RewriteStatus @default(GENERATED)
  
  // 校验信息
  charCount     Int?
  similarityScore Float?      // 与原文相似度
  warnings      Json          @default("[]")  // 校验警告
  
  // 审阅
  reviewedAt    DateTime?
  reviewNotes   String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  batch         RewriteBatch? @relation(fields: [batchId], references: [id])
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  step          Step?         @relation(fields: [stepId], references: [id], onDelete: SetNull)
  publishJobs   PublishJob[]

  @@index([contentItemId])
  @@index([batchId])
  @@index([jobId])
  @@index([stepId])
  @@index([status])
  @@map("rewrite_versions")
}

// ==================== 发布系统 ====================

model XAccount {
  id            String   @id @default(cuid())
  workspaceId   String   // 移除 @unique，支持一个 workspace 多个 X 账号
  
  // X 账号信息
  xUserId       String
  xUsername     String
  xDisplayName  String?
  xAvatar       String?
  
  // 凭证（加密存储）
  accessToken   String
  refreshToken  String?
  tokenExpiry   DateTime?
  
  // 状态
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)  // 标记默认账号
  lastUsedAt    DateTime?
  lastError     String?                   // 最后一次错误信息
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishJobs   PublishJob[]

  @@unique([workspaceId, xUserId])  // 同一 workspace 下同一 X 账号唯一
  @@index([workspaceId])
  @@index([xUserId])
  @@map("x_accounts")
}

model PublishJob {
  id            String        @id @default(cuid())
  workspaceId   String
  xAccountId    String
  rewriteVersionId String
  jobId         String?       @unique
  
  // 发布模式
  mode          String        @default("single") // single/thread
  
  // 定时
  scheduledAt   DateTime?
  
  // 状态
  status        PublishStatus @default(QUEUED)
  
  // 幂等
  idempotencyKey String?      // 幂等键，相同 key 不重复执行
  
  // 重试
  retryCount    Int           @default(0)
  maxRetries    Int           @default(3)
  lastError     String?
  
  // 结果
  resultMap     Json          @default("{}") // {position: tweet_id/url}
  
  // 时间
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  xAccount      XAccount      @relation(fields: [xAccountId], references: [id])
  rewriteVersion RewriteVersion @relation(fields: [rewriteVersionId], references: [id])
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  publishResults PublishResult[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([jobId])
  @@index([status])
  @@index([scheduledAt])
  @@index([idempotencyKey])
  @@map("publish_jobs")
}

model PublishResult {
  id              String   @id @default(cuid())
  publishJobId    String
  contentItemId   String
  
  // 发布结果
  tweetId         String
  tweetUrl        String
  position        Int      @default(0)  // 线程中的位置
  
  // 回执
  responseJson    Json     @default("{}")
  
  publishedAt     DateTime @default(now())

  publishJob      PublishJob  @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  contentItem     ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, tweetId])  // 去重键
  @@index([publishJobId])
  @@index([contentItemId])
  @@map("publish_results")
}

// ==================== 审计日志 ====================

model AuditLog {
  id            String      @id @default(cuid())
  workspaceId   String
  contentItemId String?
  
  // 操作
  action        AuditAction
  
  // 详情
  details       Json        @default("{}")
  
  // 操作者（未来可扩展为用户ID）
  actor         String      @default("system")
  
  createdAt     DateTime    @default(now())

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contentItemId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== 同步任务 (v1.2) ====================

enum SyncJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncSource {
  LIKES
  BOOKMARKS
  TIMELINE
}

// @deprecated v1 表 - 仅作为业务视图使用，编排以 Job/Step 为准
// 新代码应使用 Job/Step 模型，此表仅保留用于 Sync 进度追踪和向后兼容
model SyncJob {
  id            String        @id @default(cuid())
  workspaceId   String
  poolId        String
  source        SyncSource
  jobId         String?       @unique
  status        SyncJobStatus @default(PENDING)
  
  // 配置选项
  options       Json          @default("{}")  // { limit, mediaOnly, excludeAuthors[], includeReplies }
  
  // 进度跟踪
  progress      Json          @default("{}")  // { discovered, submitted, ingested, failed, deduped }
  lastCursor    String?                       // 断点续跑游标
  
  // 结果
  totalItems    Int           @default(0)
  successCount  Int           @default(0)
  failCount     Int           @default(0)
  dedupedCount  Int           @default(0)
  
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pool          Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_jobs")
}

// ==================== 内容发现系统 (Phase 5) ====================

model Topic {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?

  // 话题类型
  type          String   @default("keyword")  // keyword, hashtag, author, list

  // 查询配置
  query         String?                        // 搜索关键词
  hashtags      Json     @default("[]")        // 关联的 hashtag
  authorHandles Json     @default("[]")        // 关注的作者
  xListId       String?                        // X List ID

  // 同步配置
  syncEnabled   Boolean  @default(true)
  syncInterval  Int      @default(60)          // 同步间隔（分钟）
  lastSyncAt    DateTime?
  nextSyncAt    DateTime?

  // 过滤配置
  minLikes      Int      @default(0)
  minRetweets   Int      @default(0)
  excludeReplies Boolean @default(true)
  excludeRetweets Boolean @default(true)
  language      String?                        // 语言过滤

  // 统计
  totalDiscovered Int    @default(0)
  totalImported   Int    @default(0)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discoveries   DiscoveredContent[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([isActive])
  @@index([nextSyncAt])
  @@map("topics")
}

model DiscoveredContent {
  id            String   @id @default(cuid())
  topicId       String

  // 来源信息
  sourceId      String                         // tweet_id
  sourceUrl     String
  authorHandle  String
  authorName    String?
  authorAvatar  String?

  // 内容
  textContent   String   @db.Text
  media         Json     @default("[]")
  rawJson       Json     @default("{}")

  // 互动数据
  likeCount     Int      @default(0)
  retweetCount  Int      @default(0)
  replyCount    Int      @default(0)
  viewCount     Int      @default(0)

  // 热度评分 (算法计算)
  viralScore    Float    @default(0)

  // 状态
  isImported    Boolean  @default(false)       // 是否已导入素材池
  importedAt    DateTime?
  contentItemId String?                        // 导入后的 ContentItem ID

  // 标记
  isBookmarked  Boolean  @default(false)       // 用户收藏
  isHidden      Boolean  @default(false)       // 用户隐藏

  discoveredAt  DateTime @default(now())
  publishedAt   DateTime?                      // 原推发布时间

  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, sourceId])
  @@index([topicId])
  @@index([isImported])
  @@index([viralScore])
  @@index([discoveredAt])
  @@index([topicId, isImported, viralScore])
  @@map("discovered_contents")
}

// ==================== 自动化系统 (Phase 6) ====================

// 常青内容队列
model EvergreenQueue {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?

  // 队列配置
  isActive      Boolean  @default(true)

  // 循环设置
  cycleInterval Int      @default(168)        // 循环间隔（小时），默认 7 天
  maxReposts    Int      @default(5)          // 每条内容最大重发次数

  // 发布时间窗口
  publishWindows Json    @default("[]")       // [{ dayOfWeek: 0-6, startHour: 9, endHour: 21 }]
  timezone      String   @default("Asia/Shanghai")

  // 随机化
  randomizeOrder Boolean @default(true)       // 随机顺序
  variationEnabled Boolean @default(false)   // 启用变体

  // 统计
  totalItems    Int      @default(0)
  totalReposts  Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items         EvergreenItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([isActive])
  @@map("evergreen_queues")
}

// 常青内容项
model EvergreenItem {
  id              String   @id @default(cuid())
  queueId         String
  contentItemId   String?
  rewriteVersionId String?

  // 内容快照（避免关联删除问题）
  contentSnapshot Json     @default("{}")    // { text, media }

  // 状态
  isActive        Boolean  @default(true)
  isPaused        Boolean  @default(false)

  // 循环统计
  repostCount     Int      @default(0)
  lastPostedAt    DateTime?
  nextPostAt      DateTime?

  // 表现数据
  totalLikes      Int      @default(0)
  totalRetweets   Int      @default(0)
  totalViews      Int      @default(0)
  avgEngagement   Float    @default(0)       // 平均互动率

  // 排序权重（表现越好权重越高）
  weight          Float    @default(1.0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  queue           EvergreenQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([queueId])
  @@index([isActive, nextPostAt])
  @@index([queueId, isActive, weight])
  @@map("evergreen_items")
}

// A/B 测试变体
model ContentVariant {
  id              String   @id @default(cuid())
  rewriteVersionId String

  // 变体类型
  variantType     String   @default("tone")  // tone, length, hook, cta
  variantLabel    String                     // A, B, C...

  // 变体内容
  content         String   @db.Text

  // 生成参数快照
  generationParams Json    @default("{}")

  // 测试状态
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?

  // 表现数据
  impressions     Int      @default(0)
  likes           Int      @default(0)
  retweets        Int      @default(0)
  replies         Int      @default(0)
  clicks          Int      @default(0)

  // 计算指标
  engagementRate  Float    @default(0)
  clickRate       Float    @default(0)

  // 是否胜出
  isWinner        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([rewriteVersionId])
  @@index([isPublished])
  @@index([rewriteVersionId, isWinner])
  @@map("content_variants")
}

// 内容质量评分
model ContentScore {
  id              String   @id @default(cuid())
  contentItemId   String?
  rewriteVersionId String?

  // 评分维度（1-10）
  hookScore       Float    @default(0)       // 开头吸引力
  clarityScore    Float    @default(0)       // 表达清晰度
  engagementScore Float    @default(0)       // 互动潜力（CTA、提问）
  originalityScore Float   @default(0)       // 原创度

  // 综合评分
  overallScore    Float    @default(0)

  // 评分详情
  analysis        Json     @default("{}")    // AI 分析详情
  suggestions     Json     @default("[]")    // 改进建议

  // 警告标记
  warnings        Json     @default("[]")    // 敏感词、过长等警告

  scoredAt        DateTime @default(now())

  @@unique([rewriteVersionId])
  @@index([contentItemId])
  @@index([overallScore])
  @@map("content_scores")
}
